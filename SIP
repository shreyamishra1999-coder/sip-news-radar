let allArticles = [];
let activeTab = 'current-affairs';
let activePivot = 'all';

document.addEventListener('DOMContentLoaded', () => {
  loadConfigUI();
  setupEventListeners();
});

function loadConfigUI() {
  document.getElementById('prepBriefInput').value = localStorage.getItem('prepBrief') || DEFAULT_PREP_BRIEF;
  document.getElementById('rankingKeywordsInput').value = localStorage.getItem('rankingKeywords') || DEFAULT_RANKING_KEYWORDS;
  document.getElementById('exclusionKeywordsInput').value = localStorage.getItem('exclusionKeywords') || DEFAULT_EXCLUSION_KEYWORDS;
  document.getElementById('sourcesInput').value = localStorage.getItem('sources') || DEFAULT_SOURCES;
}

function setupEventListeners() {
  document.getElementById('configToggleBtn').addEventListener('click', () => {
    document.getElementById('configDrawer').classList.toggle('hidden');
  });

  document.getElementById('saveConfigBtn').addEventListener('click', () => {
    localStorage.setItem('prepBrief', document.getElementById('prepBriefInput').value);
    localStorage.setItem('rankingKeywords', document.getElementById('rankingKeywordsInput').value);
    localStorage.setItem('exclusionKeywords', document.getElementById('exclusionKeywordsInput').value);
    localStorage.setItem('sources', document.getElementById('sourcesInput').value);
    document.getElementById('configDrawer').classList.add('hidden');
    document.getElementById('statusMessage').textContent = "Configuration saved. Click 'Fetch Updates' to reload.";
  });

  document.getElementById('resetConfigBtn').addEventListener('click', () => {
    if (confirm("Reset configuration to default industry radar setup?")) {
      localStorage.clear();
      loadConfigUI();
    }
  });

  document.getElementById('refreshBtn').addEventListener('click', fetchAllFeeds);

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      activeTab = e.target.getAttribute('data-tab');
      renderArticles();
    });
  });

  document.querySelectorAll('.pivot-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.pivot-btn').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      activePivot = e.target.getAttribute('data-pivot');
      renderArticles();
    });
  });
}

async function fetchAllFeeds() {
  const statusMsg = document.getElementById('statusMessage');
  statusMsg.textContent = "Fetching news signals from configured RSS feeds...";
  
  const sourcesText = document.getElementById('sourcesInput').value.trim();
  const sourceLines = sourcesText.split('\n').filter(line => line.trim() !== '');
  
  const parsedSources = sourceLines.map(line => {
    const parts = line.split('|').map(p => p.trim());
    return { name: parts[0], url: parts[1], priority: parseInt(parts[2] || "1") };
  });

  allArticles = [];
  let completed = 0;

  for (const src of parsedSources) {
    try {
      const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(src.url)}`;
      const res = await fetch(apiUrl);
      const data = await res.json();

      if (data.status === 'ok' && data.items) {
        data.items.forEach(item => {
          const processed = processArticle(item, src);
          if (processed) {
            allArticles.push(processed);
          }
        });
      }
    } catch (err) {
      console.warn(`Failed to fetch source: ${src.name}`, err);
    }
    completed++;
    statusMsg.textContent = `Fetching feeds (${completed}/${parsedSources.length})...`;
  }

  statusMsg.textContent = `Fetched ${allArticles.length} industry updates. Ranked by relevance and decision signals.`;
  renderArticles();
}

function processArticle(item, source) {
  const title = item.title || "";
  const snippet = item.description ? item.description.replace(/<[^>]*>?/gm, '') : "";
  const fullText = (title + " " + snippet).toLowerCase();

  const exclusions = document.getElementById('exclusionKeywordsInput').value
    .toLowerCase().split(',').map(s => s.trim()).filter(s => s);
  for (const ex of exclusions) {
    if (fullText.includes(ex)) return null;
  }

  let score = source.priority * 10;

  const keywords = document.getElementById('rankingKeywordsInput').value
    .toLowerCase().split(',').map(s => s.trim()).filter(s => s);
  
  let matchedKeywords = [];
  keywords.forEach(kw => {
    if (fullText.includes(kw)) {
      score += 3;
      if (matchedKeywords.length < 5 && !matchedKeywords.includes(kw)) {
        matchedKeywords.push(kw);
      }
    }
  });

  let matchedSignals = [];
  DECISION_SIGNALS.forEach(sig => {
    if (fullText.includes(sig)) {
      score += 8;
      matchedSignals.push(sig);
    }
  });

  let isTopPlayer = false;
  Object.values(TOP_10_PLAYERS).flat().forEach(player => {
    if (fullText.includes(player)) {
      score += 12;
      isTopPlayer = true;
    }
  });

  const tabCategory = assignTabCategory(fullText, source.name);
  const pivots = assignPivots(fullText, isTopPlayer);

  return {
    title: item.title,
    link: item.link,
    pubDate: new Date(item.pubDate).toLocaleDateString(),
    sourceName: source.name,
    priority: source.priority,
    snippet: snippet.substring(0, 160) + "...",
    score,
    tabCategory,
    pivots,
    matchedKeywords,
    matchedSignals,
    isTopPlayer
  };
}

function assignTabCategory(text, sourceName) {
  const nameLower = sourceName.toLowerCase();
  if (nameLower.includes("agri") || text.includes("crop") || text.includes("farm") || text.includes("mandi") || text.includes("fertilizer")) return "agriculture";
  if (nameLower.includes("fmcg") || text.includes("consumer") || text.includes("hul") || text.includes("itc") || text.includes("retail")) return "fmcg";
  if (nameLower.includes("pharma") || nameLower.includes("biotech") || text.includes("drug") || text.includes("clinical") || text.includes("api")) return "biotech";
  if (nameLower.includes("supply") || text.includes("logistics") || text.includes("warehousing") || text.includes("freight")) return "operations";
  if (nameLower.includes("strategy") || text.includes("consulting") || text.includes("market entry") || text.includes("product strategy")) return "strategy";
  if (nameLower.includes("global") || text.includes("exports") || text.includes("imports") || text.includes("geopolitics")) return "global";
  return "current-affairs";
}

function assignPivots(text, isTopPlayer) {
  let pivots = [];
  if (text.includes("consulting") || text.includes("advisory") || text.includes("transformation") || text.includes("strategy")) pivots.push("consulting");
  if (text.includes("supply chain") || text.includes("operations") || text.includes("logistics") || text.includes("procurement")) pivots.push("operations");
  if (text.includes("product management") || text.includes("product strategy") || text.includes("product launch") || text.includes("npd")) pivots.push("product");
  if (text.includes("commercial") || text.includes("marketing") || text.includes("pricing") || text.includes("sales") || text.includes("brand")) pivots.push("commercial");
  if (text.includes("export") || text.includes("import") || text.includes("trade") || text.includes("wto") || text.includes("foreign")) pivots.push("exports");
  if (isTopPlayer) pivots.push("top10");
  return pivots;
}

function renderArticles() {
  const container = document.getElementById('articlesContainer');
  container.innerHTML = '';

  let filtered = allArticles.filter(art => art.tabCategory === activeTab);

  if (activePivot !== 'all') {
    filtered = filtered.filter(art => art.pivots.includes(activePivot));
  }

  filtered.sort((a, b) => b.score - a.score);

  if (filtered.length === 0) {
    container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 40px 0;">No articles match the selected Tab and Pivot filter. Try fetching updates or picking "All Pivots".</p>`;
    return;
  }

  filtered.forEach(art => {
    const card = document.createElement('div');
    card.className = 'article-card';

    let tagsHtml = art.matchedKeywords.slice(0, 3).map(k => `<span class="tag">${k}</span>`).join('');
    if (art.isTopPlayer) {
      tagsHtml += `<span class="tag top-player">Top 10 Player</span>`;
    }
    art.matchedSignals.slice(0, 2).forEach(sig => {
      tagsHtml += `<span class="tag" style="background:#fef2f2; color:#991b1b;">⚡ ${sig}</span>`;
    });

    card.innerHTML = `
      <div>
        <div class="card-header">
          <span class="source-tag">${art.sourceName}</span>
          <span class="score-badge">Score: ${art.score}</span>
        </div>
        <h3 class="article-title"><a href="${art.link}" target="_blank" rel="noopener">${art.title}</a></h3>
        <p class="article-snippet">${art.snippet}</p>
        <div class="card-tags">${tagsHtml}</div>
      </div>
      <div class="card-footer">
        <span>${art.pubDate}</span>
        <span>Priority ${art.priority} Source</span>
      </div>
    `;
    container.appendChild(card);
  });
}
